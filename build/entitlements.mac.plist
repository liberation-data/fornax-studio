<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Hardened-runtime entitlements for Kiln Studio.

		Electron apps run a V8 JIT and load native modules, which the
		hardened runtime blocks unless these three exceptions are granted.
		The bundled Java runtime (Contents/Resources/server/jre) needs the
		same: HotSpot's JIT writes code at run time, and the JVM loads Kiln's
		engine libraries (server/native/*.dylib) through FFM. Both
		`mac.entitlements` and `mac.entitlementsInherit` point here so the main
		app, its helpers and bin/java are signed alike.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
